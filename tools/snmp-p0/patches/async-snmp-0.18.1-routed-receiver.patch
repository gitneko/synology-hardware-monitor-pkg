 impl NotificationReceiver {
+    /// Import independently authenticated remote state without resetting a
+    /// newer receiver baseline. Callers must approve the sender identity first.
+    pub fn seed_authenticated_remote(&self, state: crate::v3::EngineState) -> Result<()> {
+        crate::v3::validate_engine_id(state.engine_id())?;
+        if state.authenticated_time().is_none() {
+            return Err(Error::Config("authenticated remote time required".into()).boxed());
+        }
+        let mut table = self.inner.remote_engines.lock().unwrap();
+        let key = state.engine_id().clone();
+        if table.update(&key, |current| {
+            current.merge_from(&state);
+            ((), Instant::now())
+        }).is_none() {
+            table.insert(key, state, Instant::now());
+        }
+        Ok(())
+    }
+
+    /// Process one caller-routed datagram through the unchanged USM/PDU path.
+    /// Callers enforce source, size and routing policy before this boundary.
+    /// Acceptance is still required and may reject Informs before any response.
+    pub async fn process_datagram(
+        &self,
+        data: Bytes,
+        source: SocketAddr,
+    ) -> Result<Option<ReceivedNotification>> {
+        if data.len() > self.inner.max_message_size {
+            return Err(Error::Config("routed datagram exceeds receiver limit".into()).boxed());
+        }
+        let _guard = self.inner.recv_gate.lock().await;
+        self.parse_and_respond(data, source, None).await
+    }
