+    /// Import a previously authenticated observation. The caller supplies the
+    /// original monotonic observation instant, never an unauthenticated Report.
+    pub fn from_authenticated_observation(
+        engine: DiscoveredEngine,
+        boots: u32,
+        time: u32,
+        observed_at: Instant,
+    ) -> Result<Self> {
+        validate_engine_id(engine.engine_id())?;
+        validate_authenticated_time(boots, time)?;
+        if observed_at > Instant::now() {
+            return Err(Error::Config("future authenticated observation".into()).boxed());
+        }
+        Ok(Self {
+            discovered: engine,
+            authenticated_time: Some(AuthenticatedEngineTime::new_at(boots, time, observed_at)),
+        })
+    }
