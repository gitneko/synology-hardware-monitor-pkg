 impl NotificationReceiver {
+    /// Authenticate and decode a remote authPriv trap as a polling hint only.
+    ///
+    /// This explicitly does NOT establish freshness: a replay may pass. It
+    /// runs the normal crypto, strict PDU and acceptance-policy checks with a
+    /// disposable remote clock. No live replay state is read or changed, no
+    /// notification contents are returned, and local-authoritative messages
+    /// and reportable messages are excluded. Callers must opt in per sender,
+    /// approve identity/source separately, and bound the resulting polls.
+    pub async fn authenticated_trap_poll_hint(
+        &self,
+        data: Bytes,
+        source: SocketAddr,
+    ) -> Result<bool> {
+        use crate::message::{RawV3Message, SecurityLevel};
+        if data.len() > self.inner.max_message_size {
+            return Ok(false);
+        }
+        let raw = RawV3Message::decode(data.clone(), self.inner.decode_config)?.value;
+        if raw.security_level() != SecurityLevel::AuthPriv
+            || raw.global_data().msg_flags().reportable
+        {
+            return Ok(false);
+        }
+        let usm = crate::v3::UsmSecurityParams::decode(
+            raw.security_params().clone(),
+            self.inner.decode_config,
+        )?
+        .value;
+        if usm.engine_id() == &self.inner.engine_id {
+            return Ok(false);
+        }
+        let _guard = self.inner.recv_gate.lock().await;
+        let clocks = Mutex::new(RemoteEngineTable::new(1));
+        Ok(self
+            .handle_v3_with_remote_engines(data, source, None, &clocks)
+            .await?
+            .is_some_and(|received| {
+                !received.notification.is_confirmed() && received.inform_ack.is_none()
+            }))
+    }
